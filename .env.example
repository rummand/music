# Copy to .env (or set in Railway). Without MUX_API_KEY the server runs in mock mode.
PORT=3000
MUX_BASE_URL=https://mux-production-0b55.up.railway.app
MUX_API_KEY=
MUX_VISION_MODEL=vision
MUX_TEXT_MODEL=smart
# 1 = never call mux; return a fixed example tune (for frontend work and tests)
MUX_MOCK=0
# Optional
# MUX_TIMEOUT_MS=120000
# MUX_MOCK_DELAY_MS=1000
# RATE_LIMIT_READ=20     # reads per IP per 10 minutes (0 = off)
# RATE_LIMIT_EDIT=60     # edits per IP per 10 minutes (0 = off)
